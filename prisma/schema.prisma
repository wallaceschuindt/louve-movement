generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Settings {
  id            String  @id @default("default")
  brandName     String  @default("Louve Movement")
  brandSubtitle String  @default("Controle Financeiro e de Estoque")
  brandLogo     String?
  pixKey        String  @default("financeiro@louvemovement.com")
}

model Product {
  id        String   @id @default(cuid())
  code      String
  name      String
  category  String
  print     String
  color     String
  cost      Float
  price     Float
  minStock  Int
  image     String   @default("")
  
  // Sizes
  sizeP     Int      @default(0)
  sizeM     Int      @default(0)
  sizeG     Int      @default(0)
  sizeGG    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaleRecord {
  id            String   @id @default(cuid())
  date          String
  clientName    String   @default("")
  clientPhone   String   @default("")
  clientEmail   String   @default("")
  paymentMethod String
  total         Float
  totalCost     Float
  
  items         SaleItem[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        SaleRecord @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  productId   String
  name        String
  code        String
  print       String
  color       String
  size        String
  qty         Int
  price       Float
  cost        Float
  image       String   @default("")
}

model OtherProduct {
  id          String   @id @default(cuid())
  code        String
  name        String
  description String
  category    String
  cost        Float
  price       Float
  minStock    Int
  stock       Int
  unitType    String
  kitSize     Int
  image       String   @default("")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OtherSaleRecord {
  id            String   @id @default(cuid())
  date          String
  clientName    String   @default("")
  clientPhone   String   @default("")
  clientEmail   String   @default("")
  paymentMethod String
  total         Float
  totalCost     Float
  
  items         OtherSaleItem[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OtherSaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        OtherSaleRecord @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  productId   String
  name        String
  code        String
  category    String
  unitType    String
  qty         Int
  price       Float
  cost        Float
  image       String   @default("")
}